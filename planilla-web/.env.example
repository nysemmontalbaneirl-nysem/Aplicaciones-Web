PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=planilla_construccion
DB_USER=postgres
DB_PASSWORD=escribe_aqui_tu_contrasena_de_postgres

# Clave usada para firmar las sesiones de login. Genera la tuya con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_unica

# Desde que direccion(es) puede llamar al backend el navegador (separadas
# por coma si hace falta mas de una). Si no se pone nada, por defecto
# permite los puertos de desarrollo de Vite (5173 y 4173) para no romper
# el flujo local. Cuando el sistema quede publicado en un dominio real, hay
# que poner ese dominio aqui (ej. https://planillas.jhcr.pe).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
