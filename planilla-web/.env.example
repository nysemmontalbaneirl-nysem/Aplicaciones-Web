PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=planilla_construccion
DB_USER=postgres
DB_PASSWORD=escribe_aqui_tu_contrasena_de_postgres

# Clave usada para firmar las sesiones de login. Genera la tuya con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_unica

# Desde que direccion(es) puede llamar al backend el navegador (separadas
# por coma si hace falta mas de una). Si no se pone nada, por defecto
# permite los puertos de desarrollo de Vite (5173 y 4173) para no romper
# el flujo local. Cuando el sistema quede publicado en un dominio real, hay
# que poner ese dominio aqui (ej. https://planillas.jhcr.pe).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Respaldo automatico de la base de datos (scripts/respaldo.js) ---
# Ruta completa a pg_dump.exe si no esta en el PATH de Windows. Normalmente
# esta junto a donde se instalo pgAdmin/PostgreSQL, algo asi como:
# "C:\Program Files\PostgreSQL\16\bin\pg_dump.exe"
PG_DUMP_PATH=pg_dump
# Ruta completa a pg_restore.exe (junto a pg_dump.exe), solo se usa si
# alguna vez hay que restaurar un respaldo con scripts/restaurar.js.
PG_RESTORE_PATH=pg_restore
# Carpeta sincronizada con Google Drive/OneDrive donde copiar el respaldo.
BACKUP_DIR_NUBE=C:\Users\TU_USUARIO\Google Drive\Respaldos Planilla
# Carpeta en un disco externo/USB donde copiar el respaldo.
BACKUP_DIR_EXTERNO=D:\Respaldos Planilla
# Cuantos dias de respaldos conservar en cada destino (se borran los mas viejos).
BACKUP_RETENCION_DIAS=30

# --- Envio de boletas por correo (pestana Boletas) ---
# Datos SMTP de la cuenta de correo desde la que se envian las boletas.
# Normalmente los da el panel de hosting (cPanel u otro) de tu dominio, en
# la seccion "Cuentas de correo" -> "Configurar cliente de correo". Ver
# docs/correo.md para el detalle paso a paso.
SMTP_HOST=mail.tu-dominio.com
SMTP_PORT=587
# true si el puerto es 465 (SSL), false si es 587 (STARTTLS, lo mas comun).
SMTP_SECURE=false
SMTP_USER=boletas@tu-dominio.com
SMTP_PASSWORD=escribe_aqui_la_contrasena_de_esa_cuenta_de_correo
# Remitente que ve el trabajador al recibir el correo (nombre + la misma
# cuenta de SMTP_USER).
SMTP_FROM="Planillas JHCR <boletas@tu-dominio.com>"
